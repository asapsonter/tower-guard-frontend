{
  "name": "@tower-guard/hooks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf .turbo dist"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "dependencies": {
    "@tower-guard/api-client": "workspace:*",
    "@tower-guard/data": "workspace:*",
    "@tower-guard/supabase-client": "workspace:*",
    "@tower-guard/ui": "workspace:*"
  },
  "devDependencies": {
    "@tower-guard/config": "workspace:*",
    "@types/react": "^18.3.0",
    "typescript": "^5.5.0"
  }
}
