# Each app (apps/dashboard-main, apps/dashboard-nscdc, apps/dashboard-ncc, apps/app-field)
# can have its own .env.local file. These variables must be prefixed with VITE_
# to be exposed to the browser by Vite.

# Supabase (public-safe — anon key only; NEVER put service_role key here)
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<from Supabase dashboard → Project Settings → API>

# Backend API (the FastAPI service — lives in the separate tower-guard-backend repo)
VITE_API_BASE_URL=http://localhost:5050
VITE_WS_BASE_URL=ws://localhost:5050

# Optional: Mapbox / Leaflet tiles
# VITE_MAPBOX_TOKEN=pk.xxxxx
