# dashboard-main env vars (validated by src/env.ts via zod)

# Backend FastAPI base URL
VITE_API_BASE_URL=http://localhost:5050

# Supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT

# Which telecom mast does the office hardware (AX-Pro PIR, cameras) represent?
# When the AX-Pro fires an alarm, the dispatch is attributed to this mast so
# operators see "MTN Maitama Tower" in the NSCDC dashboard instead of a
# generic placeholder. The ID must match an entry in mockTelecomMasts in
# packages/data/src/nigeria-data.ts. Default is tm_021 (MTN Maitama Tower).
VITE_HARDWARE_MAST_ID=tm_021
